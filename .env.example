# Copy this file to .env.local and fill in your Supabase project's values
# (Settings → API in the Supabase dashboard). Never put the service_role
# key here — only the anon/public key, which is safe to ship to the browser
# because row-level security policies protect the data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: required in the URL (?key=...) to reach /admin/login and
# /staff/login at all — obscurity only, not real access control (this is
# a static frontend, so a determined visitor could find these in the
# built JS). Leave unset to disable the gate entirely. Pick your own
# random values, e.g. `openssl rand -base64 12`.
VITE_ADMIN_ACCESS_KEY=
VITE_STAFF_ACCESS_KEY=
